# Copy to .env and fill in. .env is gitignored; never commit it.
#
#   cp .env.example .env
#
# Every `task` target loads .env automatically (Taskfile `dotenv`). A variable
# already exported in your shell wins over the file.

# ---------------------------------------------------------------------------
# LLM — LiteLLM proxy (or any OpenAI-compatible endpoint)
# ---------------------------------------------------------------------------

# Base URL of the proxy. Include the /v1 suffix — LiteLLM serves the
# OpenAI-compatible routes there.
LLM_BASE_URL=https://litellm.example.com/v1

# Virtual key issued by the proxy.
LLM_API_KEY=sk-litellm-xxxxxxxxxxxxxxxxxxxx

# Model name exactly as it appears in the proxy's model_list. Passed through
# verbatim unless it looks like "provider:model" (e.g. "openai:gpt-4o"), in
# which case the provider prefix is stripped.
LLM_MODEL=claude-sonnet-4-5

# Optional cumulative token ceilings — a coarse safety net against a runaway
# investigation or a runaway week, independent of *why* usage is climbing.
# Both unset by default: no ceiling is enforced, current behavior unchanged.
# A number picked without knowing your actual tolerance is a guess wearing a
# default's clothes, so there isn't one here — set your own.
#
# Counts input+output tokens across every LLM call the agent makes, tracked
# in-memory (resets on pod restart — see
# docs/specs/investigation-cost-guardrails.md for why that's deliberate).
# Once a ceiling is reached, the next call fails fast (before hitting the
# network) with a clear error, and the affected incident is flagged rather
# than silently retried.
# LLM_TOKEN_BUDGET_DAILY=500000
# LLM_TOKEN_BUDGET_WEEKLY=2000000

# ---------------------------------------------------------------------------
# Local run (task run-local) — the agent on your machine against port-forwards.
# Ignored by the in-cluster deployment, which uses deploy/agent/configmap.yaml.
# ---------------------------------------------------------------------------

PROMETHEUS_URL=http://localhost:9091
LOKI_URL=http://localhost:3100
TEMPO_URL=http://localhost:3200
LOG_LEVEL=INFO

# ---------------------------------------------------------------------------
# E2E tests
# ---------------------------------------------------------------------------

# Seconds to wait for an alert to fire and an investigation to finish.
#
# Measured on a live cluster before the hypothesis breadth cap
# (docs/specs/investigation-cost-guardrails.md) landed: a real-LLM
# investigation completes in ~4 minutes in the common case, but with no cap on
# how wide the hypothesis tree could grow, a run could pass 10 minutes still
# making genuine progress, not hung. The cap now bounds worst case to roughly
# 38 hypotheses instead of the 100-200+ observed, which should make that tail
# rare — not yet re-measured on a live cluster, so 1800s stays the value until
# it is.
E2E_TIMEOUT=1800
