# Copy to .env and fill in. .env is gitignored; never commit it.
#
#   cp .env.example .env
#
# Every `task` target loads .env automatically (Taskfile `dotenv`). A variable
# already exported in your shell wins over the file.

# ---------------------------------------------------------------------------
# LLM — LiteLLM proxy (or any OpenAI-compatible endpoint)
# ---------------------------------------------------------------------------

# Base URL of the proxy. Include the /v1 suffix — LiteLLM serves the
# OpenAI-compatible routes there.
LLM_BASE_URL=https://litellm.example.com/v1

# Virtual key issued by the proxy.
LLM_API_KEY=sk-litellm-xxxxxxxxxxxxxxxxxxxx

# Model name exactly as it appears in the proxy's model_list. Passed through
# verbatim unless it looks like "provider:model" (e.g. "openai:gpt-4o"), in
# which case the provider prefix is stripped.
LLM_MODEL=claude-sonnet-4-5

# ---------------------------------------------------------------------------
# Local run (task run-local) — the agent on your machine against port-forwards.
# Ignored by the in-cluster deployment, which uses deploy/agent/configmap.yaml.
# ---------------------------------------------------------------------------

PROMETHEUS_URL=http://localhost:9091
LOKI_URL=http://localhost:3100
TEMPO_URL=http://localhost:3200
LOG_LEVEL=INFO

# ---------------------------------------------------------------------------
# E2E tests
# ---------------------------------------------------------------------------

# Seconds to wait for an alert to fire and an investigation to finish. Real-LLM
# investigations are slower than the 300s default.
E2E_TIMEOUT=600
